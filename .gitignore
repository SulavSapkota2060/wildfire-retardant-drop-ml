# ---------------------------------------------------------------
# Data and models never go in git (too big, and not code).
# No trailing slashes, so a symlink to the lab folder is ignored too.
# ---------------------------------------------------------------
/data
/training_data
/dem_tiles
/models/*
!/models/README.md

# Safety net: data and model file types are ignored anywhere in the repo,
# including while files are still sitting loose in the old folder layout.
*.csv
*.geojson
*.pkl
*.joblib
*.parquet
*.npy
*.npz
*.h5
*.tif
*.tiff
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.shp.xml

# Large generated outputs (small figures like .png in outputs/ are fine to commit)
/outputs/*.csv
/outputs/*.geojson

# ---------------------------------------------------------------
# Python / Jupyter
# ---------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.pytest_cache/

# ---------------------------------------------------------------
# Secrets and OS / editor files
# ---------------------------------------------------------------
.env
*.pem
id_rsa*
id_ed25519*
.DS_Store
.idea/
.vscode/
.vscode
